# PRE-MIGRATION single-host candidate; superseded by Render/Neon/R2/Modal.
# Configure real secrets in the backend provider secret manager, never Git.
DATABASE_URL=postgresql://catalog_reader:REPLACE@DB_HOST/mini_nota?sslmode=verify-full
ENGINE_SECRET=REPLACE_WITH_RANDOM_PRIVATE_ENGINE_SECRET
CHECKPOINT_SIGNING_KEY=REPLACE_WITH_STABLE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ASSET_MANIFEST=/assets/manifest.json
ASSET_MANIFEST_SHA256=REPLACE_WITH_SHA256_OF_RELEASE_MANIFEST
RAW_DIR=/assets/raw
MODEL_BUNDLE=/assets/model.json
OUTCOMES_CSV=/assets/outcomes.csv
PORT=8000
ENGINE_PORT=8001
TMPDIR=/run/mini-nota
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=1

# Optional durable runs; apply python -m scripts.init_run_store as schema owner first.
# Distinct credentials from the immutable catalog-reader DATABASE_URL above.
# RUN_DATABASE_URL=postgresql://run_writer:REPLACE@DB_HOST/mini_nota?sslmode=verify-full&options=-csearch_path%3Drun_store
# Local development only; production must use R2_RESULTS_* (#17).
# LOCAL_ARTIFACT_DIR=/absolute/private/development-artifacts
