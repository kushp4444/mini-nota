# Render only. Fill in its secret settings; never source worker/upload credentials here.
EXECUTION_BACKEND=modal
CATALOG_DATABASE_URL=postgresql://catalog_reader:REPLACE@NEON_HOST/mini_nota?sslmode=verify-full&connect_timeout=10
RUN_DATABASE_URL=postgresql://run_writer:REPLACE@NEON_HOST/mini_nota?sslmode=verify-full&connect_timeout=10
CHECKPOINT_SIGNING_KEY=REPLACE_WITH_STABLE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MODAL_APP_NAME=mini-nota
MODAL_FUNCTION_NAME=run_phase
MODAL_ENVIRONMENT=main
MODAL_TOKEN_ID=REPLACE_WITH_DISPATCHER_MODAL_TOKEN_ID
MODAL_TOKEN_SECRET=REPLACE_WITH_DISPATCHER_MODAL_TOKEN_SECRET
R2_RESULTS_ENDPOINT_URL=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_RESULTS_BUCKET=REPLACE_PRIVATE_RESULTS_BUCKET
R2_RESULTS_ACCESS_KEY_ID=REPLACE_RESULTS_READ_ONLY_KEY_ID
R2_RESULTS_SECRET_ACCESS_KEY=REPLACE_RESULTS_READ_ONLY_SECRET
R2_RESULTS_PREFIX=runs
# PORT is supplied by Render. No ENGINE_URL, source keys or LOCAL_ARTIFACT_DIR.
