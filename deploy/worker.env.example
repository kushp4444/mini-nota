# Only mini-nota-worker Modal Secret. Operator paths/upload/deploy tokens excluded.
RUN_DATABASE_URL=postgresql://run_writer:REPLACE@NEON_HOST/mini_nota?sslmode=verify-full&connect_timeout=10
CHECKPOINT_SIGNING_KEY=REPLACE_WITH_THE_SAME_STABLE_DISPATCHER_SECRET
ASSET_MANIFEST=/app/config/manifest.json
ASSET_MANIFEST_SHA256=afb52b9c96b756890f4050f0f3b02157bc2618fa4892dfd68cbd0f6f4b637217
R2_ASSETS_ENDPOINT_URL=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ASSETS_BUCKET=REPLACE_PRIVATE_SOURCE_BUCKET
R2_ASSETS_ACCESS_KEY_ID=REPLACE_SOURCE_READ_ONLY_KEY_ID
R2_ASSETS_SECRET_ACCESS_KEY=REPLACE_SOURCE_READ_ONLY_SECRET
R2_RESULTS_ENDPOINT_URL=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_RESULTS_BUCKET=REPLACE_PRIVATE_RESULTS_BUCKET
R2_RESULTS_ACCESS_KEY_ID=REPLACE_RESULTS_READ_WRITE_KEY_ID
R2_RESULTS_SECRET_ACCESS_KEY=REPLACE_RESULTS_READ_WRITE_SECRET
R2_RESULTS_PREFIX=runs
