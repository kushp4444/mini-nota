# Server-only. Configure separate private source and results buckets; never NEXT_PUBLIC_*.
# Modal receives source-read and results-write/read; Render receives results-read only.
R2_ASSETS_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ASSETS_BUCKET=mini-nota-assets
R2_ASSETS_ACCESS_KEY_ID=
R2_ASSETS_SECRET_ACCESS_KEY=
R2_RESULTS_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_RESULTS_BUCKET=mini-nota-results
R2_RESULTS_ACCESS_KEY_ID=
R2_RESULTS_SECRET_ACCESS_KEY=
R2_RESULTS_PREFIX=runs
# Bootstrap operator only, omitted from workers/dispatcher.
R2_UPLOAD_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_UPLOAD_BUCKET=mini-nota-assets
R2_UPLOAD_ACCESS_KEY_ID=
R2_UPLOAD_SECRET_ACCESS_KEY=
ASSET_MANIFEST=/deployment/config/release-assets-v1.json
ASSET_MANIFEST_SHA256=afb52b9c96b756890f4050f0f3b02157bc2618fa4892dfd68cbd0f6f4b637217
