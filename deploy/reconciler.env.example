# Only mini-nota-reconciler Modal Secret. Manual function has no periodic schedule.
RUN_DATABASE_URL=postgresql://run_writer:REPLACE@NEON_HOST/mini_nota?sslmode=verify-full&connect_timeout=10
CHECKPOINT_SIGNING_KEY=REPLACE_WITH_THE_SAME_STABLE_DISPATCHER_SECRET
MODAL_APP_NAME=mini-nota
MODAL_FUNCTION_NAME=run_phase
# Modal injects its runtime invocation identity; no personal token/source keys needed here.
MODAL_ENVIRONMENT=main
